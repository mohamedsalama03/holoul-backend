{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "holoul/backend",
  "type": "project",
  "description": "HOLOUL modular-monolith API foundation",
  "license": "proprietary",
  "require": {
    "php": "~8.4.0",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-redis": "~6.3.0",
    "aws/aws-sdk-php": "~3.395.4",
    "giggsey/libphonenumber-for-php": "~9.0.39",
    "laravel/framework": "~13.32.0",
    "laravel/sanctum": "~4.3.3",
    "pragmarx/google2fa": "~9.1.0"
  },
  "require-dev": {
    "larastan/larastan": "3.12.1",
    "laravel/pint": "1.32.1",
    "mockery/mockery": "1.6.15",
    "nunomaduro/collision": "8.9.5",
    "phpstan/phpstan": "2.2.14",
    "phpunit/phpunit": "12.5.35"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "vendor/bin/phpunit",
    "test:architecture": "vendor/bin/phpunit --testsuite Architecture",
    "analyse": "vendor/bin/phpstan analyse --no-progress",
    "lint": "vendor/bin/pint --test"
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/sanctum"
      ]
    }
  },
  "config": {
    "platform": {
      "php": "8.4.25"
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
