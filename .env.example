# Optional overrides. Values are placeholders, not usable credentials.
# Compose creates private development secrets automatically; do not copy this file
# to .env without replacing/removing placeholders. See README.md.
APP_ENV=<environment>
HOLOUL_DEPLOYMENT_PROFILE=production
APP_DEBUG=false
APP_KEY_FILE=<absolute-mounted-application-key-file>
APP_URL=<https-origin>
APP_TRUSTED_HOSTS=<comma-separated-exact-hostnames>
APP_TRUSTED_PROXIES=<comma-separated-trusted-proxy-addresses>
DB_HOST=<private-postgresql-host>
DB_PORT=<postgresql-port>
DB_DATABASE=<database-name>
DB_USERNAME=<runtime-role>
DB_PASSWORD_FILE=<absolute-mounted-runtime-password-file>
DB_SSLMODE=verify-full
DB_SSLROOTCERT=<absolute-trusted-postgresql-ca-file>
REDIS_HOST=<private-redis-host>
REDIS_PASSWORD_FILE=<absolute-mounted-redis-password-file>
REDIS_SCHEME=tls
REDIS_CA_FILE=<absolute-trusted-redis-ca-file>
REDIS_PREFIX=<environment-specific-prefix>
IDENTITY_MAIL_SANDBOX=false
MAIL_SCHEME=smtps
MAIL_HOST=<smtp-host>
MAIL_PORT=465
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD_FILE=<absolute-mounted-smtp-password-file>
MAIL_FROM_ADDRESS=<verified-sender-address>
DOCUMENTS_S3_ENDPOINT=<https-private-s3-endpoint>
DOCUMENTS_S3_REGION=<s3-region>
DOCUMENTS_S3_BUCKET=<private-versioned-bucket>
DOCUMENTS_S3_ACCESS_KEY_FILE=<runtime-access-key-secret-file>
DOCUMENTS_S3_SECRET_KEY_FILE=<runtime-secret-key-file>
DOCUMENTS_S3_CA_BUNDLE=<trusted-ca-bundle-path>
DOCUMENTS_SCANNER_SOCKET=<private-clamav-unix-socket>
DOCUMENTS_INSPECTOR_SOCKET=<private-inspector-unix-socket>
# Local deterministic AI adapter only; external AI requires a separately approved supplier/privacy policy.
HOLOUL_AI_ENABLED=false
HOLOUL_AI_DRIVER=sandbox
# Local Gemini pilot stays disabled until its provider/data/budget settings are approved.
HOLOUL_GEMINI_APPROVED=false
HOLOUL_GEMINI_DOCUMENTS_APPROVED=false
# Server-only secret file. Never put the key in NEXT_PUBLIC_* or commit its contents.
GEMINI_API_KEY_FILE=
# These declarations require operator evidence. They do not configure the edge,
# firewall, storage policy, encryption, or certificates themselves.
HOLOUL_EDGE_HTTPS_ENFORCED=true
HOLOUL_EDGE_RATE_LIMIT_ENABLED=true
HOLOUL_EDGE_BODY_LIMIT_BYTES=12582912
HOLOUL_PRIVATE_INFRASTRUCTURE=true
HOLOUL_STORAGE_PRIVATE=true
HOLOUL_STORAGE_VERSIONED=true
HOLOUL_STORAGE_ENCRYPTED=true
HOLOUL_PROCESS_ROLE=app
HOLOUL_WORKER_SLOT=1
HOLOUL_WORKER_SLOTS=1
HOLOUL_BACKUP_STATUS_FILE=/run/holoul-operations/backup-status.json
HOLOUL_RESTORE_STATUS_FILE=/run/holoul-operations/restore-status.json
