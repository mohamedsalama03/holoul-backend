  "components": {
    "schemas": {
      "StaffAccountCreateInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "full_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "super_admin",
                "administrator",
                "project_manager",
                "business_analyst",
                "sales",
                "reviewer",
                "support",
                "portfolio_editor"
              ]
            },
            "maxItems": 8,
            "uniqueItems": true,
            "minItems": 1
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40,
            "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{2,39}$",
            "description": "Trimmed and lowercase-normalized. Unique, immutable staff login name. No @."
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true,
            "description": "Must contain lowercase and uppercase letters and a number. Never returned, logged or emailed."
          },
          "password_confirmation": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true,
            "description": "Must match password."
          }
        },
        "required": [
          "email",
          "full_name",
          "roles",
          "username",
          "password",
          "password_confirmation"
        ]
      },
      "StaffAccountRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "full_name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{2,39}$"
          },
          "full_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "StaffAccountResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StaffAccountRecord"
          }
        }
      },
      "StaffAccountErrorEnvelope": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "MALFORMED_REQUEST",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "METHOD_NOT_ALLOWED",
                  "CONFLICT",
                  "STALE_VERSION",
                  "REQUEST_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "VALIDATION_FAILED",
                  "PRECONDITION_REQUIRED",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "description": "Only present for validation errors; safe field names and fixed messages.",
                "type": "object",
                "maxProperties": 100,
                "propertyNames": {
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]{0,127}$"
                },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "const": "This field is invalid."
                  }
                }
              },
              "reason": {
                "type": "string",
                "enum": [
                  "LAST_ENABLED_SUPER_ADMIN",
                  "ROLE_AUTHORITY_EXCEEDED",
                  "SECURITY_ROLE_RESTRICTED",
                  "STAFF_CUSTOMER_ROLE_MIX",
                  "PASSWORD_CONFIRMATION_REQUIRED",
                  "EMAIL_ALREADY_STAFF",
                  "EMAIL_ALREADY_CUSTOMER",
                  "INVITATION_ALREADY_PENDING",
                  "IDEMPOTENCY_KEY_REUSED",
                  "INVITATION_ALREADY_ACCEPTED",
                  "INVITATION_ALREADY_REVOKED",
                  "INVITATION_EXPIRED",
                  "INVITATION_RESEND_LIMIT",
                  "INVITATION_UNAVAILABLE",
                  "INVITATION_SIGN_OUT_REQUIRED",
                  "NOT_FOUND",
                  "STALE_VERSION",
                  "PRECONDITION_REQUIRED",
                  "USERNAME_UNAVAILABLE",
                  "ACCOUNT_UNAVAILABLE"
                ]
              },
              "resource_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "UsernameLoginInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40,
            "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{2,39}$",
            "description": "Trimmed and lowercase-normalized. Unique, immutable staff login name. No @."
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "writeOnly": true
          }
        }
      }
    }
  }
}
