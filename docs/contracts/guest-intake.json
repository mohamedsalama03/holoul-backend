    "/api/v1/guest/project-requests/{projectRequest}/submissions": {
      "post": {
        "operationId": "guestIntakeSubmit",
        "tags": [
          "Guest intake"
        ],
        "summary": "Submit a guest idea",
        "description": "Same-origin HTTPS session and CSRF required. Dedicated fail-closed limits. An authenticated or pending-MFA session cannot use anonymous intake. Private request data is never returned by guest routes. Maximum JSON body 128 KiB. One immutable canonical submission. Same-key + same normalized payload + original If-Match replays the receipt within the 30-minute capability lifetime; a different key/body returns 409. Missing/inactive/mismatched taxonomy is invalid. USD exponent 2 / LYD exponent 3; no floats. Optional attachment must be Quarantined or Available. No email-account lookup or automatic association. Every guest gets the identical next-step message. Preserve claim_token for explicit authenticated claim; expires in 72 hours. Final success returns a confirmation receipt only, without a current-resource ETag; exact retries preserve the original If-Match. Bootstrap CSRF explicitly before this workflow. This operation never saves or replaces authentication session state and never emits session/CSRF cookies. A login/MFA/logout rotation invalidates the original session/CSRF-generation draft capability binding, including explicit bootstrap with a retired cookie; preserve unsent fields locally and use authenticated intake after login.",
        "security": [],
        "x-personas": [
          "guest"
        ],
        "x-permissions": [],
        "x-frontend-feature": "Submit a guest idea",
        "x-source": [
          "routes/guest-intake.php",
          "app/Application/Intake/GuestIntakeApi.php",
          "app/Application/Intake/GuestIntakeThrottle.php",
          "app/Http/Requests/GuestIntakeRequest.php"
        ],
        "x-csrf-required": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "name": "projectRequest",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "name": "X-Intake-Capability",
            "in": "header",
            "required": true,
            "schema": {
